{
  "name": "@localbridge/server",
  "version": "1.20.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean && node -e \"const fs=require('fs'); if (fs.existsSync('src/db/migrations')) fs.cpSync('src/db/migrations', 'dist/migrations', { recursive: true })\"",
    "start": "node dist/index.js",
    "token:create": "tsx src/cli/token.ts create",
    "token:list": "tsx src/cli/token.ts list",
    "token:revoke": "tsx src/cli/token.ts revoke",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.3.0",
    "@localbridge/protocol": "workspace:*",
    "@localbridge/security": "workspace:*",
    "@localbridge/shared": "workspace:*",
    "@modelcontextprotocol/fastify": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.5.14",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
